# Copy to .env and fill in. Never commit .env. Every value here is a placeholder.
#
# Keep comments on their own lines. Docker Compose reads `KEY=value   # note` as the value
# "value   # note"; the app strips such notes, but other tools may not.

# ---------------------------------------------------------------- Application
# local | staging | production
APP_ENV=local
# demo = local mock MCP servers with synthetic data; live = the MCP URLs below
DATA_MODE=demo
LOG_LEVEL=INFO
DEFAULT_MARKET_TIMEZONE=Asia/Kolkata
# Set a long random value to require "Authorization: Bearer <token>" on /api/v1. Blank = off.
API_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set false on the API when a separate worker process runs the schedule.
SCHEDULER_ENABLED=true
# Ingest and score everything automatically the first time the database is empty.
AUTO_INITIAL_REFRESH=true

# ---------------------------------------------------------------- Database (PostgreSQL via psycopg 3)
# scripts/dev.sh starts this database with Docker Compose when it is local and not running.
# postgres://, postgresql:// and postgresql+asyncpg:// URLs are rewritten to postgresql+psycopg://.
# For a managed database add ?sslmode=require.
DATABASE_URL=postgresql+psycopg://markets:change-me-locally@localhost:5432/markets
# Password of the local Compose database (must match DATABASE_URL). PostgreSQL applies it only when the
# volume is first created; changing it later needs ALTER USER (see analysis/HOW_TO_RUN.md, troubleshooting).
POSTGRES_PASSWORD=change-me-locally
# The schema comes from Alembic migrations (scripts/dev.sh runs them). Leave false.
AUTO_CREATE_SCHEMA=false

# ---------------------------------------------------------------- Cache (optional)
# Blank = in-process cache and locks (fine for one API process). With a separate worker use Redis,
# e.g. redis://localhost:6379/0 locally or redis://redis:6379/0 inside Compose.
REDIS_URL=

# ---------------------------------------------------------------- Market data over MCP (live mode)
# NSE MCP is the primary source; Kite MCP fills gaps and is used to cross-check NSE values.
NSE_BHAVCOPY_MCP_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_CM_MARKET_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp
BROKER_MCP_URL=https://mcp.kite.trade/mcp

# NSE corporate filings: quarterly/annual financial results (XBRL) and con-call transcripts (PDF),
# as filed with NSE. Neither NSE MCP nor the Kite MCP exposes these. Leave the URL empty to disable.
NSE_FILINGS_BASE_URL=https://www.nseindia.com/api
NSE_FILINGS_DOCUMENT_HOSTS=nsearchives.nseindia.com
NSE_FILINGS_MIN_INTERVAL_SECONDS=1.0
NSE_FILINGS_TIMEOUT_SECONDS=30
NSE_FILINGS_MAX_COMPANIES_PER_RUN=400
#
# Universe: "reference" = the curated list in backend/data/reference/nse_universe.csv;
# "all" = every NSE-listed equity (series below), with NSE's industry classification where NSE publishes one.
# Prices for the whole market come from NSE's daily bhavcopy files (one file per trading day for all stocks).
UNIVERSE_SCOPE=all
UNIVERSE_SERIES=EQ,BE
NSE_EQUITY_LIST_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv
NSE_INDUSTRY_LIST_URL=https://nsearchives.nseindia.com/content/indices/ind_niftytotalmarket_list.csv
NSE_BHAVCOPY_URL_TEMPLATE=https://nsearchives.nseindia.com/content/cm/BhavCopy_NSE_CM_0_0_0_{yyyymmdd}_F_0000.csv.zip
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_CONCURRENCY=4
MCP_MAX_RETRIES=2
NSE_MCP_MIN_INTERVAL_SECONDS=0.2
BROKER_MCP_MIN_INTERVAL_SECONDS=0.35
# Kite binds your approval to the MCP session. Keep the session id (backend/var/kite_mcp_session.json, owner-only,
# never logged or sent to the browser) so a login survives API restarts; false forgets it on every restart.
KITE_PERSIST_SESSION=true
# While logged in, re-confirm the Kite session this often (seconds); 0 disables.
KITE_KEEPALIVE_SECONDS=300
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=60

# ---------------------------------------------------------------- LLM: any OpenAI-compatible provider
# The app calls POST {LLM_BASE_URL}/chat/completions. Switch provider by changing these values only.
LLM_ENABLED=false
# Display name shown in the app
LLM_PROVIDER_NAME=OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
# Server-side only; never commit a real key
LLM_API_KEY=
# Exact id as the provider lists it (OpenRouter: https://openrouter.ai/models)
LLM_MODEL_ID=z-ai/glm-5.3-flash
# Optional JSON objects: extra headers and extra request-body fields sent with every call.
# OpenRouter: attribution headers, usage accounting so each call's cost is reported, and low reasoning effort:
# reasoning models (GLM, o-series, R1) count thinking against LLM_MAX_OUTPUT_TOKENS and can otherwise return no answer.
LLM_EXTRA_HEADERS={"X-Title": "Markets Intelligence"}
LLM_EXTRA_BODY={"usage": {"include": true}, "reasoning": {"effort": "low", "exclude": true}}
# json_schema (strict structured output) | json_object | none (schema is sent in the prompt instead)
LLM_RESPONSE_FORMAT=json_schema
# Check LLM_MODEL_ID against GET {LLM_BASE_URL}/models before a paid call (false if the provider has no model list)
LLM_VERIFY_MODEL_LIST=true
#
# Other providers, for example:
#   OpenAI:        LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL_ID=gpt-4o-mini            LLM_EXTRA_BODY=
#   Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL_ID=<model id>             LLM_EXTRA_BODY=
#   Together:      LLM_BASE_URL=https://api.together.xyz/v1         LLM_MODEL_ID=<model id>             LLM_EXTRA_BODY=
#   Ollama local:  LLM_BASE_URL=http://localhost:11434/v1           LLM_API_KEY=ollama  LLM_RESPONSE_FORMAT=json_object  LLM_VERIFY_MODEL_LIST=false
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=6000
# Model calls per UTC day, and tokens per UTC day
LLM_DAILY_BUDGET=200
LLM_DAILY_TOKEN_BUDGET=2000000

# ---------------------------------------------------------------- Web research
# ddgs (no key needed) | brave | none. Always off in demo mode (demo symbols are fictional).
WEB_SEARCH_PROVIDER=ddgs
# Only needed for brave
WEB_SEARCH_API_KEY=
# Endpoint for HTTP search providers (brave): https://api.search.brave.com/res/v1/news/search
WEB_SEARCH_BASE_URL=
WEB_SEARCH_MAX_RESULTS=8

# ---------------------------------------------------------------- Schedules (cron, DEFAULT_MARKET_TIMEZONE)
# Themes monthly, sector rotation every 12 hours
THEME_REFRESH_CRON=30 6 1 * *
RRG_REFRESH_CRON=0 */12 * * *
PRICE_REFRESH_CRON=30 19 * * 1-5
INSTRUMENT_REFRESH_CRON=0 7 * * 1-5
ALERTS_CRON=*/15 * * * *

# ---------------------------------------------------------------- Universe, cache TTLs (seconds), limits
BENCHMARK_SYMBOL=NIFTY 50
HISTORY_YEARS=3
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=21600
CACHE_TTL_INSTRUMENT=86400
RATE_LIMIT_RESEARCH_PER_MINUTE=6
RATE_LIMIT_REFRESH_PER_MINUTE=3
RATE_LIMIT_DEFAULT_PER_MINUTE=300
MAX_REQUEST_BYTES=5000000
